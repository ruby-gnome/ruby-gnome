install-so: install-headers
install-headers:
	$(INSTALL_DATA) $(srcdir)/rb-gobject-introspection.h $(RUBYARCHDIR)

install: install-pc
install-pc:
	$(RUBY) -rfileutils -e "d, f = ARGV; exit if d.to_s.empty?; FileUtils.mkdir_p(d); FileUtils.install(f, d, mode: 0644)" "$(pkgconfigdir)" ruby-gobject-introspection.pc
